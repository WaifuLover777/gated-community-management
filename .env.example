# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env real al repositorio.

# Clave secreta de Flask (usada para firmar las sesiones).
# OBLIGATORIA en producción: si falta, la app NO arranca (sin DEBUG).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Conexión a la base de datos.
# Por defecto usa SQLite en ./data/urbanizacion.db
# Para PostgreSQL (escalable):
# DATABASE_URL=postgresql://usuario:password@localhost:5432/villa_los_ceibos
# DATABASE_URL=sqlite:///data/urbanizacion.db

# Modo debug (True solo en desarrollo). NUNCA True en producción.
FLASK_DEBUG=True

# Enviar la cookie de sesión solo por HTTPS. True en producción (con TLS).
SESSION_COOKIE_SECURE=False

# Token de servicio para la API JSON (/api/*).
# Vacío = API deshabilitada (responde 503). Define un token largo y aleatorio
# para activarla; los clientes deben enviarlo en la cabecera X-API-Key.
API_TOKEN=

# Recargo por mora aplicado por cada mes de atraso sobre el monto de la cuota
# (acumulativo). 0.10 = 10% mensual.
RECARGO_MORA_MENSUAL=0.10

# --- Lectura de placas (ANPR) ---
# sim            = lee la placa del NOMBRE del archivo (demo, sin internet).
# local          = ANPR REAL en CPU con ONNX (detección + OCR). Sin nube ni token.
#                  Modelos se cachean en ~/.cache (descarga única la 1.ª vez).
# platerecognizer = OCR REAL de los píxeles vía API PlateRecognizer.
#                   Requiere token gratuito (platerecognizer.com) + internet.
RECOG_PLACA_BACKEND=sim
PLATERECOGNIZER_TOKEN=

# --- Reconocimiento facial ---
# sim   = detecta el rostro real, pero solo identifica con la MISMA foto (demo).
# local = embeddings reales con InsightFace (reconoce otra pose/luz/ropa).
#         Requiere: pip install insightface onnxruntime
RECOG_ROSTRO_BACKEND=sim

# Similitud coseno mínima para dar por identificado un rostro (0-1).
RECOG_ROSTRO_UMBRAL=0.45

# --- Cámaras de la garita (frontal, trasera, cabina) ---
# emulador_archivo = imagen más reciente de data/camaras/<nombre>/ (sin hardware).
# ip_movil         = stream MJPEG de un celular (IP Webcam / DroidCam) -> URL.
# webcam           = webcam local; la URL es el índice (0 = integrada).
# subida           = el guardia sube el frame desde la UI.
CAMARA_FRONTAL_BACKEND=emulador_archivo
CAMARA_FRONTAL_URL=
CAMARA_TRASERA_BACKEND=emulador_archivo
CAMARA_TRASERA_URL=
CAMARA_CABINA_BACKEND=emulador_archivo
CAMARA_CABINA_URL=

# Días que se conservan las fotos de evidencia de accesos.
EVIDENCIA_RETENCION_DIAS=30

# --- Notificaciones ---
# consola = solo se registran en el log. email = envío real por SMTP.
NOTIF_BACKEND=consola
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=True
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@urbanizacion.local

# Nota: TZ_OFFSET_HORAS (zona horaria local, Ecuador = -5) se lee de os.environ,
# no de este archivo. Expórtala en el entorno del proceso si necesitas cambiarla.
